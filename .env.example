# Copy to .env.local for the local docker stack, or .env for the remote
# project. Both are gitignored; this skeleton is the committed reference.

# --- Required by the app -----------------------------------------------
# Local:  run `supabase start`, then take these from `supabase status`.
# Remote: Supabase dashboard -> Project Settings -> API.
#
# Both are NEXT_PUBLIC_ by design. The anon/publishable key is meant to be
# public; RLS is what protects the data. The service-role key must never
# appear in a NEXT_PUBLIC_ variable or in application code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Local development only --------------------------------------------
# Local Postgres connection string, from `supabase status`.
SUPABASE_DB_URL=

# Local service_role key, from `supabase status`. Bypasses RLS. Used only
# by the E2E reset helper running in Node against the local stack.
SUPABASE_SERVICE_ROLE_KEY=

# --- Remote deployment only --------------------------------------------
# Remote database password, shown once when the project was created.
# Needed by `supabase link` and `supabase db push`, not by the app.
SUPABASE_DB_PASSWORD=
