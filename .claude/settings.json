{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash",
      "mcp__playwright",
      "mcp__shadcn"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "BASH_MAX_TIMEOUT_MS": "360000",
    "BASH_DEFAULT_TIMEOUT_MS": "360000"
  }
}